    "Paperweight has nothing to quiet yet. Pick the apps or categories to make quiet first." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Paperweight aún no tiene nada que silenciar. Elige primero las apps o categorías que quieres silenciar."
          }
        },
        "ja" : {
          "stringUnit" : {
