        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "가끔 MIFARE Classic인 경우도 있어요 — 대개 여전히 인식되지만, NTAG가 더 안전해요."
          }
        },
        "nl" : {
          "stringUnit" : {
