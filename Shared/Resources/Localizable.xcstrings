        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Een bos ontspruit achter de woorden."
          }
        }
      }
    },
    "A quiet day can start right now." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un día silencioso puede comenzar ahora mismo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "静かな日は今すぐ始められます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "조용한 날은 지금 바로 시작할 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Een stille dag kan nu meteen beginnen."
          }
        }
      }
    },
    "A scan is already in progress. Try again in a moment." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ya hay un escaneo en curso. Inténtalo de nuevo en un momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "スキャンは既に進行中です。しばらくしてからもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "스캔이 이미 진행 중이에요. 잠시 후 다시 시도해 주세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Er is al een scan bezig. Probeer het straks opnieuw."
          }
        }
      }
    },
    "A way out, briefly." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Una salida, brevemente."
          }
        },
        "ja" : {
          "stringUnit" : {
