    },
    "A day off has to be set the day before." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un día libre debe programarse el día anterior."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "休みの日は前日までに設定する必要があります。"
