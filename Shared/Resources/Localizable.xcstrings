    },
    "A forest sprouts behind the words." : {
      "comment" : "Quiet theme description",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un bosque brota detrás de las palabras."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "文字の背後に森が芽吹きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "글자 뒤로 숲이 돋아나요."
