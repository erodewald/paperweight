          }
        }
      }
    },
    "Paperweight Recovery Codes" : {
      "comment" : "Default file name when saving recovery codes",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Códigos de recuperación de Paperweight"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Paperweight 復旧コード"
          }
