{
  "sourceLanguage": "en",
  "strings": {
    " · ": {
      "comment": "Joins short facts on one line; keep the spaces"
    },
    "%@ %@": {
      "comment": "A time and a weekday name; reorder freely",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@"
          }
        }
      }
    },
    "%@ %lld": {
      "comment": "Short weekday name then day of month: 'Mon 14'; reorder freely",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$lld"
          }
        }
      }
    },
    "%@ hours open up at midnight.": {
      "comment": "A number of hours (may be 2.5) that become open at the day boundary"
    },
    "%@ quiet hours this week": {},
    "%@ tmrw": {
      "comment": "Lock Screen; a time then 'tomorrow' shortened; keep under 24 characters"
    },
    "%@ tomorrow": {
      "comment": "A time, then the word tomorrow"
    },
    "%@ · %@": {
      "comment": "Two short phrases joined by a middle dot",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@"
          }
        }
      }
    },
    "%@ – %@": {
      "comment": "A date range across months\nA date range: first day, en dash, last day",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ – %2$@"
          }
        }
      }
    },
    "%@. %@": {
      "comment": "Theme title, then its one-line description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. %2$@"
          }
        }
      }
    },
    "%@–%lld": {
      "comment": "A range inside one month: 'Sep 21' then the last day's number",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@–%2$lld"
          }
        }
      }
    },
    "%lld apps": {
      "comment": "How many apps are chosen; has a plural rule",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld app"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld apps"
                }
              }
            }
