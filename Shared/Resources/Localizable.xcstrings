        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "トークンをなくしましたか？ 時間制の解除を開始"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "태그를 잃어버리셨나요? 시간제 해제 시작하기"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tag kwijt? Start tijdelijke ontgrendeling"
          }
        }
      }
    },
    "Metal detunes the antenna and the phone won't read it. If it must go on a fridge or lockbox, buy an “on-metal” / “anti-metal” tag." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El metal desafina la antena y el teléfono no podrá leerlo. Si debe ir en un refrigerador o caja fuerte, compra una etiqueta “para metal” / “antimetal”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "金属はアンテナの調整を乱すため、iPhoneがタグを読み取れなくなります。冷蔵庫や金属製の箱に取り付ける場合は、耐金属対応のタグをご購入ください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "금속은 안테나를 방해해서 휴대폰이 태그를 인식하지 못해요. 냉장고나 보관함에 붙여야 한다면 '금속용' 태그를 구매하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Metaal ontstemt de antenne, waardoor de telefoon hem niet kan lezen. Als hij toch op een koelkast of kluisje moet, koop dan een “on-metal” / “anti-metal” tag."
          }
        }
      }
    },
    "NFC is not supported on this device." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
