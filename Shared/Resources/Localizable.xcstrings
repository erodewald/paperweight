        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "쉬는 날은 하루 전에 설정해야 해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Een vrije dag moet je de dag ervoor instellen."
